<.header>
  Map CSV Columns
  <:subheader>Select which column contains each field</:subheader>
</.header>

<div class="max-w-2xl mx-auto mt-8">
  <.card>
    <.card_header>
      <.card_title>Column Mapping</.card_title>
    </.card_header>
    
    <.card_body>
      <p class="mb-4">Please select which column from your CSV file contains each piece of transaction data.</p>
      
      <form phx-submit="process">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()}>
        
        <%= for header <- @headers do %>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text"><%= header %></span>
            </label>
            <select name="column_mapping[<%= header %>]" class="select select-bordered w-full">
              <option value="">-- Ignore this column --</option>
              <option value="amount">Amount ($)</option>
              <option value="date">Date</option>
              <option value="location">Location</option>
              <option value="memo">Memo/Description</option>
            </select>
          </div>
        <% end %>
        
        <div class="mt-6">
          <button type="submit" class="btn btn-primary">Continue to Import</button>
        </div>
      </form>
    </.card_body>
  </.card>
</div>
